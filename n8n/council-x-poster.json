{
  "name": "Council X Poster (n8n -> Gradio)",
  "id": "council-x-poster-n8n",
  "description": "Polls Grok outbox every 15 min, posts via HF Gradio Space, logs to pipeline state. OAuth 1.0a enforced in Space.",
  "nodes": [
    {
      "name": "Every 15 Min",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [240, 300],
      "parameters": {
        "rule": { "interval": [{ "field": "minutes", "minutesInterval": 15 }] }
      }
    },
    {
      "name": "Fetch Grok Outbox",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [520, 300],
      "parameters": {
        "method": "GET",
        "url": "https://PLACEHOLDER-drive-or-api/grok-bot-outbox.json",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "Authorization", "value": "Bearer PLACEHOLDER_TOKEN" }] }
      }
    },
    {
      "name": "Has Drafts?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [800, 300],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [{ "leftValue": "={{ $json.drafts }}", "operator": { "type": "array", "operation": "notEmpty" } }],
          "combinator": "and"
        }
      }
    },
    {
      "name": "Process One Draft",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [1080, 300],
      "parameters": { "batchSize": 1 }
    },
    {
      "name": "Post via Gradio Space",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [1360, 300],
      "parameters": {
        "method": "POST",
        "url": "https://PLACEHOLDER-username-x-poster.hf.space/gradio_api/call/post",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "Authorization", "value": "Bearer HF_TOKEN" }] },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ { data: [ $json.text, $json.media ] } }}",
        "onError": "continueRegularOutput"
      }
    },
    {
      "name": "Log to Pipeline State",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [1640, 300],
      "parameters": {
        "method": "POST",
        "url": "https://PLACEHOLDER-drive-or-api/pipeline-state/log",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "Authorization", "value": "Bearer PLACEHOLDER_TOKEN" }] },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ { tweet_id: $json.tweet_id, draft_id: $json.draft_id, status: $json.status, ts: $now.toISO() } }}",
        "onError": "continueRegularOutput"
      }
    }
  ],
  "connections": {
    "Every 15 Min": { "main": [[{ "node": "Fetch Grok Outbox", "type": "main", "index": 0 }]] },
    "Fetch Grok Outbox": { "main": [[{ "node": "Has Drafts?", "type": "main", "index": 0 }]] },
    "Has Drafts?": { "main": [[{ "node": "Process One Draft", "type": "main", "index": 0 }], []] },
    "Process One Draft": { "main": [[{ "node": "Post via Gradio Space", "type": "main", "index": 0 }]] },
    "Post via Gradio Space": { "main": [[{ "node": "Log to Pipeline State", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" }
}
